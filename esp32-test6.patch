+
+QVariantMap ComputerModel::getEsp32Settings(int computerIndex) const
+{
+    if (computerIndex < 0 || computerIndex >= m_Computers.count()) return {};
+    QReadLocker lock(&m_Computers[computerIndex]->lock);
+    const auto uuid = m_Computers[computerIndex]->uuid;
+    auto values = Esp32InputSettings::load(uuid);
+    values.insert(QStringLiteral("host_uuid"), uuid);
+    return values;
+}
+
+QString ComputerModel::saveEsp32Settings(QString hostUuid, QVariantMap values)
+{
+    // Use the UUID captured on opening, since discovery can reorder the list
+    // while the dialog is open. Never save to a different row accidentally.
+    for (auto* computer : std::as_const(m_Computers)) {
+        QReadLocker lock(&computer->lock);
+        if (computer->uuid == hostUuid) return Esp32InputSettings::save(hostUuid, values);
+    }
+    return tr("这台主机已被移除，请重新打开设置。");
 }
 
