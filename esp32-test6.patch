+bool SdlInputHandler::routeEsp32MouseButton(int button, bool down)
+{
+    unsigned index;
+    switch (button) {
+    case BUTTON_LEFT: index = 0; break;
+    case BUTTON_RIGHT: index = 1; break;
+    case BUTTON_MIDDLE: index = 2; break;
+    case BUTTON_X1: index = 3; break;
+    case BUTTON_X2: index = 4; break;
+    default: return false;
+    }
+    return m_Esp32Mouse && m_Esp32Mouse->handle(index, down);
+}
